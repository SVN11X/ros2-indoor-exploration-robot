<?xml version="1.0" ?>
<!--
  nav.world
  ─────────────────────────────────────────────────────────────────────────────
  Mundo para las pruebas de navegación autónoma Nav2 (3 escenarios).

  Diseño del recinto (~7 × 7 m):
  ┌─────────────────────────────────────────┐
  │                                         │
  │  ESC-3 META                  ESC-2 META │
  │  (-2.5, 3.0)   PASILLO        (3.0,1.5) │
  │      ╔══════════╗                  ■    │  ■ = obstáculo móvil box_obstaculo
  │      ║          ║ pasillo 0.7m     │    │
  │      ╚══════════╝                  │    │
  │                                    │    │
  │         ROBOT SPAWN (−1.5, −1.0)   │    │
  │              ●                     │    │
  │                          ESC-1 META│    │
  │                           (3.0,0.0)│    │
  └─────────────────────────────────────────┘

  Escenario 1 – Meta directa:      (3.0,  0.0) sin obstáculos intermedios
  Escenario 2 – Obstáculo:         (3.0,  1.5) box_obstaculo entre robot y meta
  Escenario 3 – Pasillo estrecho:  (-2.5, 3.0) requiere atravesar pasillo de 0.7 m

  Para escenario 2 se usa box_obstaculo (en x=1.0, y=0.7).
  Para escenarios 1 y 3 box_obstaculo queda fuera de la ruta.

  Robot spawn: x=-1.5, y=-1.0, z=0.05  (igual que obstacles.world)
  Los poses de meta en run_prueba_nav.sh:
    POSES_SIM[1]="3.0  0.0 0.0 1.0"
    POSES_SIM[2]="3.0  1.5 0.0 1.0"
    POSES_SIM[3]="-2.5 3.0 0.0 0.707"
-->
<sdf version='1.7'>
  <world name='nav'>

    <!-- ── Iluminación ──────────────────────────────────────────────────── -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ── Suelo ──────────────────────────────────────────────────────────── -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
            <contact><ode/></contact><bounce/>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PAREDES PERIMETRALES                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Pared norte (y = +4.0) -->
    <model name='pared_norte'>
      <static>1</static><pose>0 4.0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared sur (y = -4.0) -->
    <model name='pared_sur'>
      <static>1</static><pose>0 -4.0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared este (x = +4.0) -->
    <model name='pared_este'>
      <static>1</static><pose>4.0 0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 8.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 8.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared oeste (x = -4.0) -->
    <model name='pared_oeste'>
      <static>1</static><pose>-4.0 0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 8.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 8.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PASILLO ESTRECHO (Escenario 3)                                      -->
    <!-- Pasillo de 0.7 m de ancho entre x=-3.0 y x=-1.0, centrado en y=1.5 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Pared sur del pasillo -->
    <model name='pasillo_pared_sur'>
      <static>1</static>
      <!-- Desde x=-4.0 hasta x=-1.0, en y=1.15 -->
      <pose>-2.5 1.15 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>3.0 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>3.0 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/DarkGrey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared norte del pasillo -->
    <model name='pasillo_pared_norte'>
      <static>1</static>
      <!-- Desde x=-4.0 hasta x=-1.0, en y=1.85 -->
      <pose>-2.5 1.85 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>3.0 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>3.0 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/DarkGrey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared este del pasillo (tapa el lado derecho: x=-1.0, y=0..1.15) -->
    <model name='pasillo_pared_este_sur'>
      <static>1</static>
      <pose>-1.0 0.575 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 1.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 1.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/DarkGrey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- Pared este del pasillo (tapa el lado derecho: x=-1.0, y=1.85..4.0) -->
    <model name='pasillo_pared_este_norte'>
      <static>1</static>
      <pose>-1.0 2.925 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 2.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 2.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/DarkGrey</n></script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OBSTÁCULO ESCENARIO 2                                               -->
    <!-- Caja estática entre robot (spawn -1.5,-1.0) y meta ESC-2 (3.0,1.5) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <model name='box_obstaculo'>
      <static>1</static>
      <pose>1.0 0.7 0.25 0 0 0.5</pose>
      <link name='link'>
        <collision name='c'>
          <geometry><box><size>0.7 0.4 0.5</size></box></geometry>
        </collision>
        <visual name='v'>
          <geometry><box><size>0.7 0.4 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/DarkOrange</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MARCAS DE META (cilindros de colores para identificar cada escenario) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- META ESC-1: cilindro verde en (3.0, 0.0) -->
    <model name='meta_esc1'>
      <static>1</static><pose>3.0 0.0 0.01 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='poste_esc1'>
      <static>1</static><pose>3.0 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- META ESC-2: cilindro naranja en (3.0, 1.5) -->
    <model name='meta_esc2'>
      <static>1</static><pose>3.0 1.5 0.01 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='poste_esc2'>
      <static>1</static><pose>3.0 1.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- META ESC-3: cilindro azul en (-2.5, 3.0) — dentro del pasillo -->
    <model name='meta_esc3'>
      <static>1</static><pose>-2.5 3.0 0.01 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='poste_esc3'>
      <static>1</static><pose>-2.5 3.0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
