<?xml version="1.0" ?>
<!--
  giro.world  (v2)
  Plugin gazebo_ros_state agregado para /set_entity_state
-->
<sdf version='1.7'>
  <world name='giro'>

    <!-- ══ Plugin de estado — expone /set_entity_state ══════════════════════ -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <argument>set_entity_state:=set_entity_state</argument>
        <argument>get_entity_state:=get_entity_state</argument>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
            <contact><ode/></contact><bounce/>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name='pared_norte'>
      <static>1</static><pose>0 2.5 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>5.15 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>5.15 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material></visual>
      </link>
    </model>

    <model name='pared_sur'>
      <static>1</static><pose>0 -2.5 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>5.15 0.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>5.15 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material></visual>
      </link>
    </model>

    <model name='pared_este'>
      <static>1</static><pose>2.5 0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 5.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 5.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material></visual>
      </link>
    </model>

    <model name='pared_oeste'>
      <static>1</static><pose>-2.5 0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 5.15 0.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 5.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><n>Gazebo/Grey</n></script></material></visual>
      </link>
    </model>

    <!-- Referencia yaw=0: disco azul (sin colisión) -->
    <model name='marca_yaw0'>
      <static>1</static><pose>0.5 0 0.005 0 0 0</pose>
      <link name='link'>
        <visual name='v'>
          <geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='poste_yaw0'>
      <static>1</static><pose>0.5 0 0.75 0 0 0</pose>
      <link name='link'>
        <visual name='v'>
          <geometry><cylinder><radius>0.02</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
